generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  OWNER_ADMIN
  SALES_AGENT
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum ServiceCategory {
  TOUR
  HAJJ_UMRAH
  WORK_PERMIT
  STUDENT_VISA
}

enum LeadStage {
  NEW
  QUALIFIED
  QUOTED
  FOLLOW_UP
  WON
  LOST
}

enum LeadSource {
  PHONE
  WEBSITE
  MESSENGER
  WHATSAPP
  OTHER
}

enum QuotationStatus {
  DRAFT
  APPROVED
  VOID
}

enum FollowUpStatus {
  OPEN
  DONE
  CANCELLED
}

enum AiDraftType {
  CUSTOMER_REPLY
  QUALIFICATION
  PACKAGE_SUGGESTION
  QUOTATION_EXPLANATION
}

enum AiDraftReviewStatus {
  DRAFT
  ACCEPTED
  EDITED
  DISCARDED
}

model StaffUser {
  id               String       @id @default(uuid())
  email            String       @unique
  name             String
  passwordHash     String
  role             StaffRole    @default(SALES_AGENT)
  status           StaffStatus  @default(ACTIVE)
  refreshTokenHash String?
  lastLoginAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  assignedLeads     Lead[]          @relation("AssignedLeads")
  leadNotes         LeadNote[]
  followUpTasks     FollowUpTask[]
  createdQuotes     Quotation[]     @relation("CreatedQuotes")
  approvedQuotes    Quotation[]     @relation("ApprovedQuotes")
  sharedQuotes      Quotation[]     @relation("SharedQuotes")
  aiDrafts          AiDraft[]
  auditLogs         AuditLog[]

  @@index([role, status])
  @@map("staff_users")
}

model AgencySettings {
  id                    String   @id @default(uuid())
  agencyName            String   @default("TravelPilot Agency")
  legalName             String?
  logoUrl               String?
  address               String?
  phone                 String?
  email                 String?
  website               String?
  defaultCurrency       String   @default("BDT")
  taxRate               Decimal  @default(0.00) @db.Decimal(5, 2)
  quotationTerms        String   @db.Text
  quotationValidityDays Int      @default(7)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("agency_settings")
}

model Package {
  id                String          @id @default(uuid())
  category          ServiceCategory @default(TOUR)
  title             String
  destination       String
  durationDays      Int
  durationNights    Int
  description       String          @db.Text
  inclusions        String[]
  exclusions        String[]
  requiredDocuments String[]        @default([])
  structuredSpecs   Json?
  basePrice         Decimal         @db.Decimal(12, 2)
  currency          String          @default("BDT")
  validFrom         DateTime?
  validUntil        DateTime?
  isArchived        Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  quotationItems QuotationItem[]

  @@index([category, destination, isArchived])
  @@map("packages")
}

model Lead {
  id                 String          @id @default(uuid())
  trackingCode       String?
  category           ServiceCategory @default(TOUR)
  customerName       String
  customerPhone      String?
  customerEmail      String?
  source             LeadSource      @default(PHONE)
  destination        String?
  travelStartDate    DateTime?
  travelEndDate      DateTime?
  travelerCount      Int?
  budget             Decimal?        @db.Decimal(12, 2)
  requirements       String?         @db.Text
  stage              LeadStage       @default(NEW)
  eligibilityStatus  String?
  documentChecklist  Json?
  milestoneChecklist Json?
  metadata           Json?
  assignedToId       String?
  assignedTo         StaffUser?      @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  notes         LeadNote[]
  followUpTasks FollowUpTask[]
  quotations    Quotation[]
  aiDrafts      AiDraft[]

  @@index([trackingCode])
  @@index([category, stage, assignedToId])
  @@index([createdAt])
  @@map("leads")
}

model LeadNote {
  id        String    @id @default(uuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String
  author    StaffUser @relation(fields: [authorId], references: [id], onDelete: Restrict)
  content   String    @db.Text
  createdAt DateTime  @default(now())

  @@index([leadId])
  @@map("lead_notes")
}

model FollowUpTask {
  id           String         @id @default(uuid())
  leadId       String
  lead         Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedToId String
  assignedTo   StaffUser      @relation(fields: [assignedToId], references: [id], onDelete: Restrict)
  title        String
  note         String?        @db.Text
  dueAt        DateTime
  status       FollowUpStatus @default(OPEN)
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([assignedToId, status, dueAt])
  @@map("follow_up_tasks")
}

model Quotation {
  id                 String          @id @default(uuid())
  leadId             String
  lead               Lead            @relation(fields: [leadId], references: [id], onDelete: Restrict)
  quoteNumber        String
  revision           Int             @default(1)
  status             QuotationStatus @default(DRAFT)
  currency           String          @default("BDT")
  subtotal           Decimal         @db.Decimal(12, 2)
  discount           Decimal         @default(0.00) @db.Decimal(12, 2)
  taxAmount          Decimal         @default(0.00) @db.Decimal(12, 2)
  grandTotal         Decimal         @db.Decimal(12, 2)
  validUntil         DateTime
  termsAndConditions String          @db.Text
  notes              String?         @db.Text
  createdById        String
  createdBy          StaffUser       @relation("CreatedQuotes", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById       String?
  approvedBy         StaffUser?      @relation("ApprovedQuotes", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt         DateTime?
  sharedAt           DateTime?
  sharedByStaffId    String?
  sharedByStaff      StaffUser?      @relation("SharedQuotes", fields: [sharedByStaffId], references: [id], onDelete: SetNull)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  items QuotationItem[]

  @@unique([quoteNumber, revision])
  @@index([leadId, status])
  @@map("quotations")
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  packageId   String?
  package     Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  title       String
  description String?   @db.Text
  quantity    Int       @default(1)
  unitPrice   Decimal   @db.Decimal(12, 2)
  totalPrice  Decimal   @db.Decimal(12, 2)
  currency    String    @default("BDT")
  orderIndex  Int       @default(0)

  @@index([quotationId])
  @@map("quotation_items")
}

model AiDraft {
  id                 String              @id @default(uuid())
  leadId             String
  lead               Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorStaffId      String
  authorStaff        StaffUser           @relation(fields: [authorStaffId], references: [id], onDelete: Restrict)
  type               AiDraftType         @default(CUSTOMER_REPLY)
  language           String              @default("en")
  promptSummary      String?             @db.Text
  suggestedText      String              @db.Text
  missingInformation String[]
  sourcePackageIds   String[]
  modelProvider      String              @default("openai")
  modelName          String              @default("gpt-4o-mini")
  reviewStatus       AiDraftReviewStatus @default(DRAFT)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([leadId])
  @@map("ai_drafts")
}

model AuditLog {
  id         String     @id @default(uuid())
  actorId    String?
  actor      StaffUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime   @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
