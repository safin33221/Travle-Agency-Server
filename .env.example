NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/travelpilot?schema=public
FRONTEND_URL=http://localhost:3000

JWT_ACCESS_SECRET=travelpilot-access-secret-min-32-chars-long
